# Every setting the app reads.
# - Secrets (LLM_API_KEY, MISTRAL_API_KEY, SEARCH_API_KEY, LANGFUSE_SECRET_KEY): on macOS keep
#   them in the Keychain, service "jobadvaisor", account = the name in lower case with dashes,
#   e.g. `security add-generic-password -U -s jobadvaisor -a llm-api-key -w` (hidden prompt).
#   The app reads them itself; nothing is exported to the shell. Without a Keychain (Linux, CI)
#   set them in the environment or in a gitignored .env in the repository root.
# - Everything else (models, URLs, paths, thresholds, LANGFUSE_PUBLIC_KEY) goes into the
#   gitignored local.env in the repository root. Never put a secret there.
# Precedence: Keychain, then the shell environment, then .env, then local.env.

# Path to your data repository (profile, policy pack, postings, labels).
DATA_REPOSITORY=

# Directory for the rebuildable local stores (vector index, run checkpoints), one subdirectory
# per data repository. Defaults to ~/.jobadvaisor, outside this repository.
STATE_DIRECTORY=

# Chat models, as LangChain init_chat_model identifiers (e.g. provider:model).
# LLM_MODEL / LLM_BASE_URL are the default for every role; a role's own values override them.
# With a base URL set, a name without a provider: prefix goes to that OpenAI-compatible endpoint,
# so router names work as they are (e.g. LLM_BASE_URL=https://router.requesty.ai/v1,
# LLM_MODEL=openai/gpt-5.4-mini).
LLM_MODEL=
LLM_BASE_URL=
# API key for every chat, embedding and guard-model client, e.g. one router key.
# Without it, each LangChain provider package reads its own variable (e.g. OPENAI_API_KEY)
# from the process environment, not from these files.
LLM_API_KEY=
EXTRACTOR_MODEL=
EXTRACTOR_BASE_URL=
JUDGE_MODEL=
JUDGE_BASE_URL=
INTAKE_MODEL=
INTAKE_BASE_URL=
AGENT_MODEL=
AGENT_BASE_URL=

# Embedding model, as a LangChain init_embeddings identifier; uses LLM_BASE_URL when set.
EMBEDDING_MODEL=

# Content guard: screens third-party text with the first classifier available, in this order:
# 1. GUARD_MODEL (e.g. typesafe/jev-1.13.0), a model that answers the router's `questions`
#    format; GUARD_BASE_URL falls back to LLM_BASE_URL.
# 2. Mistral Moderation, when MISTRAL_API_KEY is set.
# 3. None: screening is off (the structural defenses stay).
# The guard fails closed: a failed call or an answer missing a configured category raises.
# GUARD_THRESHOLDS is a JSON object of category -> threshold (0-1). Unset, each classifier uses
# its own: GUARD_MODEL {"instructions_for_ai": 0.5, "dangerous": 0.5}, Mistral
# {"jailbreaking": 0.5, "dangerous": 0.5, "criminal": 0.5}. A value replaces them, so list every
# category of the active classifier; an empty object is rejected.
GUARD_MODEL=
GUARD_BASE_URL=
MISTRAL_API_KEY=
GUARD_THRESHOLDS=

# Web-search provider key for company research. Without it, research returns "unavailable".
SEARCH_API_KEY=

# Set to 1 to run the opt-in live smoke test against the Bundesagentur für Arbeit interface.
BA_LIVE_TEST=
# Minimum training labels for the logistic-regression eval (default 100)
COMPETITOR_MIN_LABELS=

# Langfuse tracing. Off unless both keys are set; LANGFUSE_BASE_URL is optional.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
