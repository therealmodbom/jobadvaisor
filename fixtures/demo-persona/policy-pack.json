{
  "schema_version": "1",
  "exclusion_rules": [
    {
      "id": "no-on-call",
      "field": "text",
      "operator": "contains_any",
      "value": [
        "24/7 on-call",
        "night shifts"
      ]
    },
    {
      "id": "no-unpaid",
      "field": "title",
      "operator": "matches_regex",
      "value": "(?i)\\b(unpaid|volunteer)\\b"
    },
    {
      "id": "no-betting",
      "field": "company",
      "operator": "equals",
      "value": "Demo Co. Lucky Spin"
    }
  ],
  "reason_chips": [
    {
      "id": "too-junior",
      "label": "Stelle zu junior",
